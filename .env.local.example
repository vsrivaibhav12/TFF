# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ACCESS_TOKEN=sbp_your-access-token
SUPABASE_PROJECT_REF=your-project-ref

# Email
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=noreply@thefiscalfulcrum.com

# Crypto (AES-256-GCM key for credentials vault)
# Must be base64 of exactly 32 bytes. Generate with: openssl rand -base64 32
CREDENTIALS_KEY=replace-with-output-of-openssl-rand-base64-32

# Cron: Vercel sends this as 'Authorization: Bearer <CRON_SECRET>'. Required, crons refuse to run without it.
CRON_SECRET=replace-with-a-random-string

# Public URL of the app (password reset emails link here)
NEXT_PUBLIC_APP_URL=https://portal.fiscalfulcrum.in

# Seed / demo accounts
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-password
TEAM_SEED_PASSWORD=replace-with-a-strong-password

# Super-admin accounts (used by scripts/seed-super-admins.ts)
SUPER_ADMIN_MITHUNA_PASSWORD=replace-with-a-strong-password
SUPER_ADMIN_VAIBHAV_PASSWORD=replace-with-a-strong-password
